{
  "backend": "lightgbm",
  "model_type": "lightgbm_ensemble",
  "config": {
    "seed": 0,
    "learning_rate": 0.03,
    "num_leaves": 31,
    "max_depth": 6,
    "min_data_in_leaf": 1000,
    "feature_fraction": 0.8,
    "bagging_fraction": 0.8,
    "bagging_freq": 1,
    "lambda_l2": 20.0,
    "max_rounds": 1000,
    "early_stopping_rounds": 100,
    "num_threads": 4
  },
  "seeds": [0, 1, 2, 3, 4],
  "target": "label_rank",
  "top_n": 30,
  "quantiles": 10,
  "preprocess": {
    "method": "rank",
    "missing_indicator": true,
    "winsorize": false,
    "neutralize": [],
    "clip_z": 5.0
  }
}
