{
  "backend": "sklearn_hist_gbdt",
  "model_type": "sklearn_hist_gbdt",
  "config": {
    "model_type": "sklearn_hist_gbdt",
    "learning_rate": 0.05,
    "max_iter": 300,
    "max_leaf_nodes": 31,
    "max_depth": 6,
    "min_samples_leaf": 1000,
    "l2_regularization": 1.0,
    "max_bins": 255,
    "validation_fraction": 0.1,
    "n_iter_no_change": 20,
    "seed": 0
  },
  "target": "label_rank",
  "top_n": 30,
  "quantiles": 10,
  "preprocess": {
    "method": "rank",
    "missing_indicator": true,
    "winsorize": false,
    "neutralize": [],
    "clip_z": 5.0
  }
}
